# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/med_db

# JWT server secret key for HS256 signing
SERVER_SECRET=your_super_secret_jwt_key_here_at_least_32_characters

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
