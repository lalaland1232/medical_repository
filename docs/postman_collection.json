{
  "info": {
    "name": "OsseoPlan Medical Implant Case Management API",
    "description": "Postman API Collection for testing all FastAPI backend endpoints with JWT authentication and RBAC permissions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shiv@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "2. Login (Superuser)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "3. Rotate Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refresh_token",
              "host": ["{{baseUrl}}"],
              "path": ["refresh_token"]
            }
          }
        },
        {
          "name": "4. Logout (Revoke Session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            }
          }
        },
        {
          "name": "5. Public Sign Up (Reviewer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. New Reviewer\",\n  \"email\": \"new.reviewer@hospital.org\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sign_up",
              "host": ["{{baseUrl}}"],
              "path": ["sign_up"]
            }
          }
        },
        {
          "name": "6. Provision Admin (Superuser Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Clinical Admin\",\n  \"email\": \"admin.new@hospital.org\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin_sign_up",
              "host": ["{{baseUrl}}"],
              "path": ["admin_sign_up"]
            }
          }
        }
      ]
    },
    {
      "name": "Case Management",
      "item": [
        {
          "name": "1. Get Cases List (Page 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cases?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["cases"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "2. Get Single Case by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cases/CASE-101",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "CASE-101"]
            }
          }
        },
        {
          "name": "3. Create Medical Case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"CASE-500\",\n  \"patient_refrence\": \"PAT-CRAN-500\",\n  \"surgeon_name\": \"Dr. Sarah Jenkins\",\n  \"priority\": \"high\",\n  \"status\": \"Planning\",\n  \"created_by\": 8,\n  \"implant_type\": \"Patient-Specific Titanium Cranial Mesh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/create_case",
              "host": ["{{baseUrl}}"],
              "path": ["create_case"]
            }
          }
        },
        {
          "name": "4. Update Case Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Review\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases/CASE-500",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "CASE-500"]
            }
          }
        },
        {
          "name": "5. Delete Case Record",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cases/CASE-500",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "CASE-500"]
            }
          }
        }
      ]
    }
  ]
}
